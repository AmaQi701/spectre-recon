# OPSEC: Never commit real engagement databases or audit reports
workspaces/*.db
workspaces/*.db-shm
workspaces/*.db-wal
workspaces/*.txt
workspaces/*.json
workspaces/*.csv
workspaces/sourcemaps/
reports/*.md
reports/*.html
reports/*.pdf
reports/*.json
reports/*.csv
reports/*.txt

# Keep empty directories
!workspaces/.gitkeep
!reports/.gitkeep

# Python & OS artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
*.deb
.DS_Store
