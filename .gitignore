# OPSEC: Never commit real engagement databases or audit reports
workspaces/*.db
workspaces/*.db-shm
workspaces/*.db-wal
workspaces/*.txt
workspaces/*.json
workspaces/*.csv
workspaces/sourcemaps/
workspaces/tmp/
reports/*.md
reports/*.html
reports/*.pdf
reports/*.json
reports/*.csv
reports/*.txt

# Keep empty directories
!workspaces/.gitkeep
!reports/.gitkeep

# Local developer / AI rules & internal notes
.clinerules
.cursorrules
MASTER_PROMPT.md
ARCHITECTURE_AND_RULES.md
ROADMAP_V13.md
ENTERPRISE_MASTER_PLAN.md
workspaces/*.py
workspaces/skills/

# Python, build, offline compiled intel pack & OS artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
dist/
intel/
!intel/.gitkeep
core/native/spectre-intel-indexer
*.deb
*.so
.DS_Store

