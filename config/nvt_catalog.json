{
  "catalog_version": "3.4.0",
  "rules": [
    {
      "id": "NVT-INFRA-001",
      "title": "Exposed Apache httpd Server-Status Telemetry",
      "category": "Infrastructure Telemetry Exposure",
      "severity": "Medium",
      "cvss": 5.8,
      "cwe": "CWE-200",
      "path": "/server-status?auto",
      "status": 200,
      "tech_any": ["apache"],
      "match_all": ["total accesses:", "score" ],
      "exclude_any": ["<html", "404"],
      "remediation": "Apache konfiguratsiyasida `/server-status` blokini faqat `Require local` ga cheklang."
    },
    {
      "id": "NVT-INFRA-002",
      "title": "Exposed Nginx Stub-Status Metrics",
      "category": "Infrastructure Telemetry Exposure",
      "severity": "Low",
      "cvss": 3.7,
      "cwe": "CWE-200",
      "path": "/nginx_status",
      "status": 200,
      "tech_any": ["nginx", "openresty"],
      "match_all": ["active connections:", "server accepts handled requests"],
      "exclude_any": ["<html"],
      "remediation": "Nginx `stub_status` joylashuvini `allow 127.0.0.1; deny all;` bilan yoping."
    },
    {
      "id": "NVT-INFRA-003",
      "title": "Exposed PHP-FPM Real-Time Pool Status",
      "category": "Infrastructure Telemetry Exposure",
      "severity": "Medium",
      "cvss": 5.3,
      "cwe": "CWE-200",
      "path": "/status?full&json",
      "status": 200,
      "tech_any": ["php", "nginx", "apache"],
      "content_type_any": ["json"],
      "match_all": ["\"pool\"", "\"accepted conn\"", "\"listen queue\""],
      "exclude_any": [],
      "remediation": "PHP-FPM `pm.status_path` manzilini tashqi veb-server location blokidan uzing."
    },
